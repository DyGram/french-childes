%--------------------------------------------------------
% Rules for graphs created with UDPipe (Default French)
% 23.09.26
%
% Rules are ranked by specificity (query stops at first match per attribute)
% ==> run dql.py with flag --first_rule  (or use childes-pipeline.sh)
%
% --merge: Codings are added to the table in the row of 'node'
% ==> run dql.py WITHOUT flag --code_head
%         (--code_head would add attributes to the row of 'addlemma')
%--------------------------------------------------------


%--------------------------------------------------------
% subj: SUBJECT
%   1=nsubj (so that nsubj:pass is also matched)
%--------------------------------------------------------

% ======= impersonal subject 
% coding attribute=subj value=clit_imp node=V addlemma=PRO
pattern {
    V -[expl:subj]-> PRO;
    V [upos=/AUX|VERB/];
%    PRO [form=/^0il/i];
}

% ======= subject clitic
% coding attribute=subj value=clit node=V addlemma=PRO
pattern {
    V [upos=/AUX|VERB/];
    PRO [PronType="Prs"];
    V -[1=nsubj]-> PRO;
}

% ======= subject noun
% coding attribute=subj value=noun node=V addlemma=N
pattern {
    V [upos=/AUX|VERB/];
    N [upos=/NOUN|PROPN/];
    V -[1=nsubj]-> N;
}

% ======= subject pronoun (not clitic): relative, demonstrative (ce, on, etc.)
% coding attribute=subj value=pro node=V addlemma=N
pattern {
    V [upos=/AUX|VERB/];
    N [upos="PRON"];
    V -[1=nsubj]-> N;
}

%%--------------------------------------------------------
% subj: SUBJECT OF COPULA
%   (UD: the predicate is root and verb depends via 'cop')
%--------------------------------------------------------

% ======= copula subject pronoun (c'est X qui...)
% coding attribute=subj value=pron_cop node=V addlemma=N
pattern {
    V [upos=/AUX|VERB/];
    PRO [upos=/PRON/];
    X -[cop]-> V;
    X -[nsubj|expl:subj]-> PRO;
}

% ======= copula subject noun (Paul est ...)
% coding attribute=subj value=noun_cop node=V addlemma=N
pattern {
    V [upos=/AUX|VERB/];
    N [upos=/NOUN|PROPN/];
    X -[cop]-> V;
    X -[nsubj]-> N;
}

% ======= copula predicate noun (c'est Paul)
% coding attribute=obj value=noun_cop node=V addlemma=N
pattern {
    V [upos=/AUX|VERB/];
    N [upos=/NOUN|PROPN/];
    N -[cop]-> V;
}

%--------------------------------------------------------
% obj: DIRECT OBJECT (including predicate of copula)
%--------------------------------------------------------

% ======= direct object person 3
% coding attribute=obj value=clit3 node=V addlemma=PRO
pattern {
    V -[obj]-> PRO;
    V [upos=/AUX|VERB/];
    PRO [form=/^l.*$/i, PronType="Prs"];
}

% ======= direct object person 1-2: me te nous vous
% coding attribute=obj value=clit12 node=V addlemma=PRO
pattern {
    V [upos=/AUX|VERB/];
    PRO [form=/^[mtvn].*$/i, PronType="Prs"];
    V -[obj]-> PRO;
}

% ======= direct object noun
% coding attribute=obj value=noun node=V addlemma=N
pattern {
    V [upos=/AUX|VERB/];
    N [upos=/NOUN|PROPN/];
    V -[obj]-> N;
}

% ======= direct object quantifier + noun (beaucoup de gens, plusieurs livres, etc.)
% coding attribute=obj value=quant node=V addlemma=N
pattern {
    V [upos=/AUX|VERB/];
    Q [upos="ADV"];
    N [upos=/NOUN|PRON/];
    V -[obj]-> Q;
    Q -> N;
}

% ======= direct object pronoun (not clitic): relative, demonstrative (cela, lui, etc.)
% coding attribute=obj value=pro node=V addlemma=N
pattern {
    V [upos=/AUX|VERB/];
    N [upos="PRON"];
    V -[obj]-> N;
}

%--------------------------------------------------------
% iobj: Dative objects
%    - only clitics seem to be parsed as 'iobj', never nominal complements (they are oblique)
%    - subordinate clauses with 'où...' are also 'iobj', but we don't code them as such (shouldn't they be ccomp?)
%--------------------------------------------------------

% ======= indirect object person 3
% coding attribute=iobj value=clit3 node=V addlemma=PRO
pattern {
    V [upos=/AUX|VERB/];
    PRO [form=/^l.*$/i, PronType="Prs"];
    V -[iobj]-> PRO;
}

% ======= indirect object person 1-2
% coding attribute=iobj value=clit12 node=V addlemma=PRO
pattern {
    V [upos=/AUX|VERB/];
    PRO [form=/^[mtvn].*$/i, PronType="Prs"];
    V -[iobj]-> PRO;
}

%--------------------------------------------------------
% refl: reflexive clitics and pronouns
%--------------------------------------------------------

% ======= reflexive
% coding attribute=refl value=clit node=V addlemma=PRO
pattern {
    V [upos=/AUX|VERB/];
    PRO [form = re"^[sS][e\']$", PronType="Prs"];   % tricky: apostrophes don't work in /regex/
    V -> PRO;    % or expl:pv ?
}

%--------------------------------------------------------
% oblique: Prepositional objects
%--------------------------------------------------------

% ======= à-PP argument
% coding attribute=oblique value=aPP node=V addlemma=N
pattern {
    V [upos=/AUX|VERB/];
    V -[obl:arg]-> N;  % target only first part of e.g. obl:arg
    N -[case]-> P;
    P [form=/^à|au|aux/i];
}

% ======= y
% coding attribute=oblique value=y node=V addlemma=PRO
pattern {
    V [upos=/AUX|VERB/];
    PRO [form="y"];
    V -> PRO;
}

% ======= en
% coding attribute=oblique value=en node=V addlemma=PRO
pattern {
    V [upos=/AUX|VERB/];
    PRO [form="en"];
    V -> PRO;
}


%--------------------------------------------------------
% modpp: modifiers as PPs
% Inconsistent dependency relations:
%   obj:   mets-le dedans, parterre, ...au lit
%   advmod [ > case]:  tu le mets là(-haut), elle monte de partout
%   obl:arg [ > case]:   monter dedans celui-là
%--------------------------------------------------------

% ======= modifier is PP
% coding attribute=modpp value=obl_arg node=V addlemma=P
pattern {
    V [upos=/AUX|VERB/];
    V -[obl:arg]-> N; 
    N -[case]-> P;
}

% coding attribute=modpp value=obl_mod node=V addlemma=P
pattern {
    V [upos=/AUX|VERB/];
    V -[obl:mod]-> N;  
    N -[case]-> P;
}

% coding attribute=modpp value=adv node=V addlemma=P
pattern {
    V [upos=/AUX|VERB/];
    V -[advmod]-> N;
    N -[case]-> P;
}

% coding attribute=modpp value=obj node=V addlemma=P
pattern {
    V [upos=/AUX|VERB/];
    V -[obj]-> N;
    N -[case]-> P;
}

%--------------------------------------------------------
% modadv: modifiers as single adverb
% Inconsistent dependency relations:
%   obj:   mets-le dedans, parterre, ...au lit
%   advmod [ > case]:  tu le mets là(-haut), elle monte de partout
%   obl:arg [ > case]:   monter dedans celui-là
%--------------------------------------------------------

% coding attribute=modadv value=obl_arg node=V addlemma=ADV
pattern {
    V [upos=/AUX|VERB/];
    V -[obl:arg]-> ADV;  
}
without {
    ADV -[case]-> P;
}

% coding attribute=modadv value=obl_mod node=V addlemma=ADV
pattern {
    V [upos=/AUX|VERB/];
    V -[obl:mod]-> ADV;  
}
without {
    ADV -[case]-> P;
}

% coding attribute=modadv value=adv node=V addlemma=ADV
pattern {
    V [upos=/AUX|VERB/];
    V -[advmod]-> ADV;
}
without {
    ADV -[case]-> P;
}

% coding attribute=modadv value=obj node=V addlemma=ADV
pattern {
    V [upos=/AUX|VERB/];
    V -[obj]-> ADV;
}
without {
    ADV -[case]-> P;
}

%--------------------------------------------------------
% modifier: Prepositional modifiers
%--------------------------------------------------------

% ======= à-PP other
% coding attribute=modifier value=aPP node=V addlemma=N
pattern {
    V [upos=/AUX|VERB/];
    V -> N;
    N -[case]-> P;
    P [form=/^à|au|aux/i];
}
without {
    V -[obl:arg]-> N;  % except oblique arguments coded as attribute oblique
}

% ======= other PP
% coding attribute=modifier value=otherPP node=V addlemma=N
pattern {
    V [upos=/AUX|VERB/];
    V -> N;
    N -[case]-> P;
}

%--------------------------------------------------------
% cp: CLAUSAL/PHRASAL COMPLEMENTS
%--------------------------------------------------------

% ======= Infinitive modal verbs: tu veux lui donner...
% coding attribute=cp value=inf_xcomp node=Vmain addlemma=V
pattern {
    Vmain [upos="VERB"];
    V [upos=/AUX|VERB/, VerbForm=Inf];
    Vmain -[xcomp]-> V;   
}

% ======= Infinitive complement clause: falloir, aller + INF
% coding attribute=cp value=inf_ccomp node=Vmain addlemma=V
pattern {
    Vmain [upos="VERB"];
    V [upos=/AUX|VERB/, VerbForm=Inf];
    Vmain -[ccomp]-> V;   
}

% ======= complement clause: 
% coding attribute=cp value=fin_xcomp node=Vmain addlemma=V
pattern {
    Vmain [upos="VERB"];
    V [upos=/AUX|VERB/];
    Vmain -[xcomp]-> V;   
}

% ======= complement clause: 
% coding attribute=cp value=fin_ccomp node=Vmain addlemma=V
pattern {
    Vmain [upos="VERB"];
    V [upos=/AUX|VERB/];
    Vmain -[ccomp]-> V;   
}

% ======= other verbal complements except passive
% coding attribute=cp value=other node=Vmain addlemma=V
pattern {
    Vmain [upos="VERB"];
    V [upos=/AUX|VERB/];
    Vmain -> V;   
}
without {
    Vmain -[aux:pass]-> V;
}

%--------------------------------------------------------
% comp: COMPLEMENTISER OF CLAUSAL/PHRASAL COMPLEMENTS
%--------------------------------------------------------

% ======= for all CPs xcomp|ccomp
% coding attribute=comp value=a node=Vmain addlemma=V
pattern {
    Vmain [upos="VERB"];
    V [upos=/AUX|VERB/];
    C [form="à"];
    Vmain -[ccomp|xcomp]-> V;
    V -> C;
}

% ======= for all CPs xcomp|ccomp
% coding attribute=comp value=de node=Vmain addlemma=V
pattern {
    Vmain [upos="VERB"];
    V [upos=/AUX|VERB/];
    C [form="de"];
    Vmain -[ccomp|xcomp]-> V;
    V -> C;
}

% ======= for all CPs xcomp|ccomp
% coding attribute=comp value=empty node=Vmain addlemma=V
pattern {
    Vmain [upos="VERB"];
    V [upos=/AUX|VERB/];
    Vmain -[ccomp|xcomp]-> V;
}
without {
    V -[mark]-> C;
}

% ======= for all CPs xcomp|ccomp
% coding attribute=comp value=other node=Vmain addlemma=V
pattern {
    Vmain [upos="VERB"];
    V [upos=/AUX|VERB/];
    Vmain -[ccomp|xcomp]-> V;
    V -> C;
}

%--------------------------------------------------------
% passive: 
%--------------------------------------------------------

% ======= other complements:
% coding attribute=passive value=1 node=V addlemma=AUX
pattern {
    V [upos="VERB"];
    AUX [upos="AUX"];
    V -[aux:pass]-> AUX;
}

%--------------------------------------------------------
% aux: AUXILIARIES
%--------------------------------------------------------

% ======= avoir aux
% coding attribute=aux value=A node=V addlemma=AUX
pattern {
    V [upos=/VERB/];
    AUX [upos="AUX", lemma="avoir"];
    V -[1=aux]-> AUX;
}

% ======= être aux
% coding attribute=aux value=E node=V addlemma=AUX
pattern {
    V [upos="VERB"];
    AUX [upos="AUX", lemma=/être|estre/];
    V -[1=aux]-> AUX;
}

%--------------------------------------------------------
% caus: causative faire/laisser + Inf 
%   The UDpipe model codes the auxiliaries differently:
%    laisser -xcomp-> INF
%    INF -aux:caus-> faire
%--------------------------------------------------------

% coding attribute=caus value=laisser node=V addlemma=Vcaus
pattern {
    Vcaus [lemma="laisser", upos=/AUX|VERB/];
    V [upos="VERB", VerbForm=Inf];
    Vcaus -[ccomp|xcomp]-> V;   
}

% coding attribute=caus value=faire node=V addlemma=Vcaus
pattern {
    Vcaus [lemma="faire", upos=/AUX|VERB/];
    V [upos="VERB", VerbForm=Inf];
    V -[1=aux]-> Vcaus;   
}

%--------------------------------------------------------
% anticaus: ANTICAUSATIVES
%   abaisser|achever|adoucir|affaiblir|aggraver|agiter|agiter|agrandir|agreger|alléger|allonger|alourdir|amaigrir|amatir|améliorer|amenuiser|amoindrir|anoblir|anuiter|apetisser|aplanir|aplatir|apparaître|apparoir|approcher|ardre|arrêter|arrondir|assécher|attendrir|attrister|augmenter|avancer|aviver|baisser|baser|bestourner|blesser|bouiller|briser|brûler|calcifier|casser|cesser|changer|claquer|clore|commencer|continuer|convertir|corrompre|couler|crever|croître|découvrir|décroitre|dégâter|demontrer|démontrer|descendre|dérouler|déserrer|dessécher|déteériorer|dilater|diminuer|dissiper|diviser|doubler|durcir|éclairer|éclater|effacer|effondre|élargir|élever|embellir|empirer|endurcir|enfaiblir|enflammer|enfler|engendrer|enlaidir|envieillir|épandre|escorlogier|esparpiellier|éteindre|étendre|évanouir|exister|fendre|finer|finir|flétrir|former|former|fortifier|glisser|grossir|guérir|incliner|intensifier|introduire|irriter|jaunir|lever|maigrir|manifester|moisir|mollir|monter|montrer|mouiller|mouillier|mourir|muer|multiplier|obscurcir|obscurer|ocire|ouvrir|parfaire|passer|perfectionner|plier|prouver|putréfier|rallumer|ramollir|rapprocher|redoubler|réduire|refreidier|refroidir|réfroidir|remplir|remuer|remuer|renforcer|renouveler|répandre|rompre|sécher|soulever|soulever|tenir|terminer|tordre|tourner|trancher|transformer|transformer|trembler|trouver|vider
%--------------------------------------------------------

% ======= anticaus yes  (AC's lemma list from R script, as of Nov 25)
% coding attribute=anticaus value=1 node=V addlemma=V
pattern {
    V [upos="VERB", lemma=/^(abaisser|achever|adoucir|affaiblir|aggraver|agiter|agiter|agrandir|agreger|alléger|allonger|alourdir|amaigrir|amatir|améliorer|amenuiser|amoindrir|anoblir|anuiter|apetisser|aplanir|aplatir|apparaître|apparoir|approcher|ardre|arrêter|arrondir|assécher|attendrir|attrister|augmenter|avancer|aviver|baisser|baser|bestourner|blesser|bouiller|briser|brûler|calcifier|casser|cesser|changer|claquer|clore|commencer|continuer|convertir|corrompre|couler|crever|croître|découvrir|décroitre|dégâter|demontrer|démontrer|descendre|dérouler|déserrer|dessécher|déteériorer|dilater|diminuer|dissiper|diviser|doubler|durcir|éclairer|éclater|effacer|effondre|élargir|élever|embellir|empirer|endurcir|enfaiblir|enflammer|enfler|engendrer|enlaidir|envieillir|épandre|escorlogier|esparpiellier|éteindre|étendre|évanouir|exister|fendre|finer|finir|flétrir|former|former|fortifier|glisser|grossir|guérir|incliner|intensifier|introduire|irriter|jaunir|lever|maigrir|manifester|moisir|mollir|monter|montrer|mouiller|mouillier|mourir|muer|multiplier|obscurcir|obscurer|ocire|ouvrir|parfaire|passer|perfectionner|plier|prouver|putréfier|rallumer|ramollir|rapprocher|redoubler|réduire|refreidier|refroidir|réfroidir|remplir|remuer|remuer|renforcer|renouveler|répandre|rompre|sécher|soulever|soulever|tenir|terminer|tordre|tourner|trancher|transformer|transformer|trembler|trouver|vider)$/];
}


%--------------------------------------------------------
% sv: WORD-ORDER SUBJECT-VERB
%--------------------------------------------------------

% ======= subject noun
% coding attribute=order_subj value=vs node=V addlemma=N
pattern {
    V [upos=/AUX|VERB/];
    V -[1=nsubj]-> N;
    V << N;
}

% ======= subject noun
% coding attribute=order_subj value=sv node=V addlemma=N
pattern {
    V [upos=/AUX|VERB/];
    V -[1=nsubj]-> N;
    N << V;
}

%--------------------------------------------------------
% right: DISTRIBUTION RIGHT
%--------------------------------------------------------

% ======= Verb + à-PP
% coding attribute=right value=aPP node=V addlemma=N
pattern {
    V [upos=/AUX|VERB/];
    RIGHT [form=/^à|au|aux/i];
    N [upos=/NOUN|PROPN|PRON/];
    V < RIGHT;
    N -> RIGHT;

}

% ======= Verb + pas + à-PP
% coding attribute=right value=aPP_neg node=V addlemma=N
pattern {
    V [upos=/AUX|VERB/];
    NEG [form=/pas|jamais|rien|personne/];
    RIGHT [form=/^à|au|aux/i];
    N [upos=/NOUN|PROPN|PRON/];
    V < NEG;
    NEG < RIGHT;
    N -> RIGHT;
}


%========================================================
% DATIVE CUES (case-selection, grew/dative-cues.dql.query)
%   Codings by form and position of the clitic, which a learner can perceive,
%   in addition to the grammatical functions above, which are parser decisions
%   based on the adult lexicon.
%   French clitic order: (subj) ne me/te/se/nous/vous le/la/les lui/leur y en V
%
%   --first_rule blocks on (attribute, addlemma node). In compound tenses the
%   clitic precedes the auxiliary, and the plain rule would code the AUX row
%   (avoir/être). The *aux rules therefore come first: they code the main verb
%   and block the plain rule for the same clitic.
%
%   Grew syntax: re"..." is OCaml Str (( | ) are literal), and /.../ cannot
%   contain an apostrophe, so forms are given as lists: form="le"|"la"|"l'".
%========================================================

%--------------------------------------------------------
% cl_pair: both object clitics in one cluster (ditransitive): le lui donne
%--------------------------------------------------------

% coding attribute=cl_pair value=acc_dat_aux node=V addlemma=PROdat
pattern {
    V [upos="VERB"];
    AUX [upos="AUX"];
    V -[1=aux]-> AUX;
    PROacc [form="le"|"la"|"les"|"l'"|"Le"|"La"|"Les"|"L'", PronType="Prs"];
    PROdat [form="lui"|"leur"|"Lui"|"Leur", PronType="Prs"];
    PROacc < PROdat;
    PROdat < AUX;
}

% coding attribute=cl_pair value=acc_dat node=V addlemma=PROdat
pattern {
    V [upos=/AUX|VERB/];
    PROacc [form="le"|"la"|"les"|"l'"|"Le"|"La"|"Les"|"L'", PronType="Prs"];
    PROdat [form="lui"|"leur"|"Lui"|"Leur", PronType="Prs"];
    PROacc < PROdat;
    PROdat < V;
}

%--------------------------------------------------------
% cl_acc: object clitic immediately before the verb or its auxiliary
%   cl3 = le/la/les/l' (accusative by form)
%   cl12 = me/te/nous/vous (case ambiguous); nous/vous are excluded where
%   they are subjects (vous nsubj is the majority reading before a verb)
%--------------------------------------------------------

% coding attribute=cl_acc value=cl3aux node=V addlemma=PRO
pattern {
    V [upos="VERB"];
    AUX [upos="AUX"];
    V -[1=aux]-> AUX;
    PRO [form="le"|"la"|"les"|"l'"|"Le"|"La"|"Les"|"L'", PronType="Prs"];
    PRO < AUX;
}

% coding attribute=cl_acc value=cl3 node=V addlemma=PRO
pattern {
    V [upos=/AUX|VERB/];
    PRO [form="le"|"la"|"les"|"l'"|"Le"|"La"|"Les"|"L'", PronType="Prs"];
    PRO < V;
}

% coding attribute=cl_acc value=cl12aux node=V addlemma=PRO
pattern {
    V [upos="VERB"];
    AUX [upos="AUX"];
    V -[1=aux]-> AUX;
    PRO [form="me"|"te"|"nous"|"vous"|"m'"|"t'"|"Me"|"Te"|"Nous"|"Vous"|"M'"|"T'", PronType="Prs"];
    PRO < AUX;
}
without {
    V -[1=nsubj]-> PRO;   % X below cannot be V: Grew matches injectively
}
without {
    X -[1=nsubj]-> PRO;
}

% coding attribute=cl_acc value=cl12 node=V addlemma=PRO
pattern {
    V [upos=/AUX|VERB/];
    PRO [form="me"|"te"|"nous"|"vous"|"m'"|"t'"|"Me"|"Te"|"Nous"|"Vous"|"M'"|"T'", PronType="Prs"];
    PRO < V;
}
without {
    V -[1=nsubj]-> PRO;   % X below cannot be V: Grew matches injectively
}
without {
    X -[1=nsubj]-> PRO;
}

%--------------------------------------------------------
% cl_dat: dative clitic lui/leur immediately before the verb or its auxiliary
%   (strong lui as subject excluded)
%--------------------------------------------------------

% coding attribute=cl_dat value=cl3aux node=V addlemma=PRO
pattern {
    V [upos="VERB"];
    AUX [upos="AUX"];
    V -[1=aux]-> AUX;
    PRO [form="lui"|"leur"|"Lui"|"Leur", PronType="Prs"];
    PRO < AUX;
}
without {
    V -[1=nsubj]-> PRO;   % X below cannot be V: Grew matches injectively
}
without {
    X -[1=nsubj]-> PRO;
}

% coding attribute=cl_dat value=cl3 node=V addlemma=PRO
pattern {
    V [upos=/AUX|VERB/];
    PRO [form="lui"|"leur"|"Lui"|"Leur", PronType="Prs"];
    PRO < V;
}
without {
    V -[1=nsubj]-> PRO;   % X below cannot be V: Grew matches injectively
}
without {
    X -[1=nsubj]-> PRO;
}

%--------------------------------------------------------
% cl_adv: y / en immediately before the verb or its auxiliary
%--------------------------------------------------------

% coding attribute=cl_adv value=yaux node=V addlemma=PRO
pattern {
    V [upos="VERB"];
    AUX [upos="AUX"];
    V -[1=aux]-> AUX;
    PRO [form="y"|"Y"];
    PRO < AUX;
}

% coding attribute=cl_adv value=y node=V addlemma=PRO
pattern {
    V [upos=/AUX|VERB/];
    PRO [form="y"|"Y"];
    PRO < V;
}

% coding attribute=cl_adv value=enaux node=V addlemma=PRO
pattern {
    V [upos="VERB"];
    AUX [upos="AUX"];
    V -[1=aux]-> AUX;
    PRO [form="en"|"En", upos="PRON"];
    PRO < AUX;
}

% coding attribute=cl_adv value=en node=V addlemma=PRO
pattern {
    V [upos=/AUX|VERB/];
    PRO [form="en"|"En", upos="PRON"];
    PRO < V;
}

%--------------------------------------------------------
% cl_post: postverbal clitic of an affirmative imperative: donne-lui, mets-le
%   Postverbal lui is ambiguous with the strong pronoun (regarde lui il dort):
%   keep separate from the preverbal cluster. The tokeniser sometimes keeps
%   the hyphen (-le, -moi).
%--------------------------------------------------------

% coding attribute=cl_post value=dat node=V addlemma=PRO
pattern {
    V [upos=/AUX|VERB/, Mood="Imp"];
    PRO [form="lui"|"leur"|"-lui"|"-leur", PronType="Prs"];
    V < PRO;
}

% coding attribute=cl_post value=acc node=V addlemma=PRO
pattern {
    V [upos=/AUX|VERB/, Mood="Imp"];
    PRO [form="le"|"la"|"les"|"-le"|"-la"|"-les", PronType="Prs"];
    V < PRO;
}

%--------------------------------------------------------
% datframe: frame of the dative clitic
%   with direct object or clausal complement = evidence for a ditransitive,
%   without = evidence for a monotransitive dative (je lui dis is both)
%--------------------------------------------------------

% coding attribute=datframe value=ditr node=V addlemma=PRO
pattern {
    V [upos=/AUX|VERB/];
    PRO [form="lui"|"leur"|"Lui"|"Leur", PronType="Prs"];
    V -[iobj]-> PRO;
    V -[obj|ccomp|xcomp]-> X;
}

% coding attribute=datframe value=mono node=V addlemma=PRO
pattern {
    V [upos=/AUX|VERB/];
    PRO [form="lui"|"leur"|"Lui"|"Leur", PronType="Prs"];
    V -[iobj]-> PRO;
}
without {
    V -[obj|ccomp|xcomp]-> X;
}

%--------------------------------------------------------
% a_nom: internal form of the à-phrase (formal correlate of animacy)
%   person-type: à Paul, à lui, à ta maman, à maman
%   determined:  à la maison, au lit (au/aux count as definite)
%   ranked from specific to general
%--------------------------------------------------------

% coding attribute=a_nom value=propn node=V addlemma=N
pattern {
    V [upos=/AUX|VERB/];
    N [upos="PROPN"];
    V -[1=obl]-> N;
    N -[case]-> P;
    P [form="à"|"au"|"aux"|"À"|"Au"|"Aux"];
}

% coding attribute=a_nom value=pron node=V addlemma=N
pattern {
    V [upos=/AUX|VERB/];
    N [upos="PRON", form="moi"|"toi"|"lui"|"elle"|"nous"|"vous"|"eux"|"elles"];
    V -[1=obl]-> N;
    N -[case]-> P;
    P [form="à"|"À"];
}

% coding attribute=a_nom value=poss node=V addlemma=N
pattern {
    V [upos=/AUX|VERB/];
    N [upos="NOUN"];
    V -[1=obl]-> N;
    N -[case]-> P;
    P [form="à"|"au"|"aux"|"À"|"Au"|"Aux"];
    N -[det]-> D;
    D [Poss="Yes"];
}

% coding attribute=a_nom value=bare node=V addlemma=N
pattern {
    V [upos=/AUX|VERB/];
    N [upos="NOUN"];
    V -[1=obl]-> N;
    N -[case]-> P;
    P [form="à"|"au"|"aux"|"À"|"Au"|"Aux"];
}
without {
    N -[det]-> D;
}

% coding attribute=a_nom value=det node=V addlemma=N
pattern {
    V [upos=/AUX|VERB/];
    N [upos="NOUN"];
    V -[1=obl]-> N;
    N -[case]-> P;
    P [form="à"|"au"|"aux"|"À"|"Au"|"Aux"];
    N -[det]-> D;
}

%--------------------------------------------------------
% v_edge: verb followed by nothing but punctuation
%   An utterance that ends at the verb is missing context, not a verb without
%   complement (binary version of n_after; counts are not expressible in Grew)
%--------------------------------------------------------

% coding attribute=v_edge value=final node=V addlemma=V
pattern {
    V [upos=/AUX|VERB/];
}
without {
    V << X;
    X [upos=/NOUN|PROPN|PRON|VERB|AUX|ADP|DET|ADJ|ADV|NUM|SCONJ|CCONJ|INTJ|PART|X/];
}


exit
